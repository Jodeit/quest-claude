<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuestClaude" parent="Theme.AppCompat.NoActionBar">
        <!-- See-through window, so the room shows through the glass where the headset allows. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
    </style>

    <!-- Flat buttons: our own rounded drawable, no AppCompat shadow or tint. -->
    <style name="QcButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/btn_accent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="QcButton.Secondary">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <!-- Small square icon button (reconnect, settings, ＋). -->
    <style name="QcButton.Icon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Full-width row in the side rail (new session, reconnect, settings). -->
    <style name="QcButton.Rail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="QcButton.Key">
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
