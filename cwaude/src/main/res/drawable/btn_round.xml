<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon button on the prompt line: solid enough to sit over terminal text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#5A4E43" /></shape></item>
    <item android:state_hovered="true"><shape android:shape="oval"><solid android:color="#463D34" /></shape></item>
    <item android:state_activated="true"><shape android:shape="oval"><solid android:color="@color/accent" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="#2E2721" /></shape></item>
</selector>
