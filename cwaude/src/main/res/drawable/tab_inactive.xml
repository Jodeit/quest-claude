<?xml version="1.0" encoding="utf-8"?>
<!-- Other sessions in the side rail: bare until the pointer is over them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/key_pressed" /><corners android:radius="16dp" /></shape></item>
    <item android:state_hovered="true"><shape><solid android:color="@color/key_hover" /><corners android:radius="16dp" /></shape></item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="16dp" /></shape></item>
</selector>
