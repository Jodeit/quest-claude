<?xml version="1.0" encoding="utf-8"?>
<!-- A pill on the glass: faint fill, lighter under the controller pointer and when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/key_pressed" /><corners android:radius="26dp" /></shape></item>
    <item android:state_hovered="true"><shape><solid android:color="@color/key_hover" /><corners android:radius="26dp" /></shape></item>
    <item><shape><solid android:color="@color/key" /><corners android:radius="26dp" /></shape></item>
</selector>
