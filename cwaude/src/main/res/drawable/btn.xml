<?xml version="1.0" encoding="utf-8"?>
<!-- Flat key: no shadow, a lighter fill under the controller pointer (hover) and when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/key_pressed" /><stroke android:width="1dp" android:color="@color/panel_stroke" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_hovered="true">
        <shape><solid android:color="@color/key_hover" /><stroke android:width="1dp" android:color="@color/panel_stroke" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/key" /><stroke android:width="1dp" android:color="@color/panel_stroke" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
