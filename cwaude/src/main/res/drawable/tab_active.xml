<?xml version="1.0" encoding="utf-8"?>
<!-- The active tab: the terminal's own background with an accent line on top, so it reads as
     the terminal's title. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/term_bg" />
            <stroke android:width="1dp" android:color="@color/panel_stroke" />
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- No border along the bottom, so the tab runs into the terminal below. -->
    <item android:height="1dp" android:gravity="bottom" android:left="1dp" android:right="1dp">
        <shape><solid android:color="@color/term_bg" /></shape>
    </item>
    <item android:height="2dp" android:gravity="top" android:left="8dp" android:right="8dp">
        <shape><solid android:color="@color/accent" /><corners android:radius="1dp" /></shape>
    </item>
</layer-list>
