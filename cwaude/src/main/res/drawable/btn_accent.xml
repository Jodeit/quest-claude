<?xml version="1.0" encoding="utf-8"?>
<!-- The one primary action (⏎). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent_pressed" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_hovered="true">
        <shape><solid android:color="@color/accent_hover" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/accent" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
