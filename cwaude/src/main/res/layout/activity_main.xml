<?xml version="1.0" encoding="utf-8"?>
<!-- Spatial glass: sessions down a side rail on the see-through window, the terminal on a darker
     glass card beside it, and the keys in a floating dock under the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Side rail: name and status, the sessions, then reconnect and settings at the foot. -->
    <LinearLayout
        android:layout_width="224dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="✳ Qlaude"
            android:textColor="@color/fg"
            android:textSize="20sp" />

        <!-- One dot for the whole setup: "Ready" when everything's up, otherwise what isn't.
             Tap it to fix the first problem (or see the checklist). -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="200dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="○ Checking…"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="SESSIONS"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- One row per tmux session. Tap to switch, ✕ (or long-press) to close. -->
                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/new_tab"
                    style="@style/QcButton.Rail"
                    android:contentDescription="New session"
                    android:focusable="false"
                    android:text="＋  New session" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/reconnect"
            style="@style/QcButton.Rail"
            android:contentDescription="Reconnect adb"
            android:text="⟳  Reconnect" />

        <Button
            android:id="@+id/settings"
            style="@style/QcButton.Rail"
            android:contentDescription="Settings"
            android:text="⚙  Settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- The Claude tmux pane, redrawn whenever it changes; tap it to type. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/term_frame"
            android:padding="1dp">

            <ScrollView
                android:id="@+id/term_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Scrollback: the conversation above the screen, appended as tmux keeps it. -->
                    <TextView
                        android:id="@+id/history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:includeFontPadding="false"
                        android:textColor="@color/fg"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <dev.cwaude.TerminalView
                        android:id="@+id/term"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:includeFontPadding="false"
                        android:text="Starting Claude…"
                        android:textColor="@color/fg"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Status line: dictation progress, and the result of the last command (reconnect, …). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dictation_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/last_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The key dock. Tap the terminal (or ⌨) to type into Claude; a hardware keyboard works
             once it has focus. Keys come in groups: input, editing keys, arrows, then send. -->
        <LinearLayout
            android:id="@+id/keybar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/mic"
                style="@style/QcButton.Secondary"
                android:layout_marginStart="0dp"
                android:text="@string/dictate" />

            <Button
                android:id="@+id/keyboard"
                style="@style/QcButton.Secondary"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_ghost"
                android:contentDescription="Show keyboard"
                android:minWidth="52dp"
                android:text="⌨" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
