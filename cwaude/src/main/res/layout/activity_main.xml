<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- One top bar, like a browser: name and status, the tabs, then reconnect and settings.
         The tabs wrap onto more rows when they don't fit; the name and buttons stay on the
         top row and the tabs' last row sits on the terminal. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="20sp" />

        <!-- One dot for the whole setup: "Ready" when everything's up, otherwise what isn't.
             Tap it to fix the first problem (or see the checklist). -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="10dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/panel"
            android:maxWidth="260dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="○ Checking…"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- One tab per tmux session, then ＋. Tap to switch, ✕ (or long-press) to close. -->
        <dev.cwaude.TabFlow
            android:id="@+id/tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_weight="1">

            <Button
                android:id="@+id/new_tab"
                style="@style/QcButton.Icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="New tab"
                android:focusable="false"
                android:text="＋"
                android:textSize="18sp" />
        </dev.cwaude.TabFlow>

        <Button
            android:id="@+id/reconnect"
            style="@style/QcButton.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top"
            android:contentDescription="Reconnect adb"
            android:text="⟳" />

        <Button
            android:id="@+id/settings"
            style="@style/QcButton.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top"
            android:contentDescription="Settings"
            android:text="⚙" />
    </LinearLayout>

    <!-- The Claude tmux pane, redrawn whenever it changes; tap it to type. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/term_frame"
        android:padding="1dp">

    <ScrollView
        android:id="@+id/term_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Scrollback: the conversation above the screen, appended as tmux keeps it. -->
            <TextView
                android:id="@+id/history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:textColor="@color/fg"
                android:textSize="12sp"
                android:visibility="gone" />

            <dev.cwaude.TerminalView
                android:id="@+id/term"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="Starting Claude…"
                android:textColor="@color/fg"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>

    <!-- Status line: dictation progress, and the result of the last command (reconnect, …). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dictation_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/last_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tap the terminal (or ⌨) to type into Claude; a hardware keyboard works once it has focus.
         Keys come in groups: input, editing keys, arrows, then send. -->
    <LinearLayout
        android:id="@+id/keybar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mic"
            style="@style/QcButton.Secondary"
            android:layout_marginStart="0dp"
            android:text="@string/dictate" />

        <Button
            android:id="@+id/keyboard"
            style="@style/QcButton.Secondary"
            android:layout_marginStart="6dp"
            android:contentDescription="Show keyboard"
            android:minWidth="56dp"
            android:text="⌨" />
    </LinearLayout>
</LinearLayout>
