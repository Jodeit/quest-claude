<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuestClaude" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
    </style>

    <style name="QcButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="QcButton.Secondary">
        <item name="android:backgroundTint">@color/key</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="QcButton.Key">
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:backgroundTint">@color/key</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">20sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="QcTab" parent="QcButton.Secondary">
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:focusable">false</item>
    </style>
</resources>
